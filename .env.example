# Upwork OAuth2 Credentials
# Get yours at https://www.upwork.com/developer/keys/apply
UPWORK_CLIENT_ID=your_client_id_here
UPWORK_CLIENT_SECRET=your_client_secret_here
UPWORK_REDIRECT_URI=http://localhost:9876/callback

# Webhook endpoint (your custom URL)
WEBHOOK_URL=https://your-endpoint.example.com/webhook

# Poll interval in minutes (default 10)
POLL_INTERVAL_MINUTES=10

# Auth server port
AUTH_SERVER_PORT=9876
