# Upwork OAuth2 Credentials
# Get yours at https://www.upwork.com/developer/keys/apply
UPWORK_CLIENT_ID=your_client_id_here
UPWORK_CLIENT_SECRET=your_client_secret_here
UPWORK_REDIRECT_URI=http://localhost:9876/callback

# Webhook endpoint (your custom URL)
WEBHOOK_URL=https://your-endpoint.example.com/webhook

# Poll interval in minutes (default 10)
POLL_INTERVAL_MINUTES=30

# Auth server port
AUTH_SERVER_PORT=9876

# --- n8n <-> bot (n8n posts to Slack and handles the buttons) ---
N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/upwork-job-event
# Long random string; n8n sends it as "Authorization: Bearer <secret>" to /api/*
BOT_API_SECRET=change-me

# --- Cover letters ---
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Which Upwork account applies ---
UPWORK_AGENCY_ORG_ID=648377821962256384
UPWORK_FREELANCER_ID=648377515317051392

# "api" = bot submits via the Upwork API; "mcp" = bot only queues and a Claude
# Code session submits through the Upwork MCP (see claude_loop/mcp_apply_loop.md)
APPLY_BACKEND=api
# Keep false until the first Slack dry-run messages look right.
AUTO_APPLY_ENABLED=false
